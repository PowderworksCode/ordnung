{
  "name": "ordnung-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "cp ../scripts/install.sh public/install && rm -rf out && powderworks-docs build content --out out --site ordnung --static public",
    "social": "python3 node_modules/powderworks-docs/tools/social-card.py --site ordnung",
    "social:check": "python3 node_modules/powderworks-docs/tools/social-card.py --site ordnung --check",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "bun test"
  },
  "dependencies": {
    "powderworks-docs": "github:PowderworksCode/docs"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
